{% extends '@KeywordModule/backOffice/default-twig/keyword/_layout.html.twig' %}

{% block kw_title %}{{ 'Edit keyword group %title'|trans({ '%title': keyword_group.title }, 'keyword') }}{% endblock %}
{% block body_testid %}keyword-group-edit-page{% endblock %}

{% block kw_breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ keyword_group.title }}</li>
{% endblock %}

{% block kw_actions %}
    {% include '@KeywordModule/backOffice/default-twig/keyword/_prev_next.html.twig' with {
        previous_url: previous_url,
        next_url: next_url,
        previous_label: 'Edit previous keyword group'|trans({}, 'keyword'),
        next_label: 'Edit next keyword group'|trans({}, 'keyword'),
    } only %}
{% endblock %}

{% block kw_body %}
    <div class="card" data-testid="keyword-group-edit-card">
        <div class="card-body">
            {% form_theme form with bo_form_themes only %}
            {{ form_start(form, { action: form_action, method: 'post', attr: { 'data-testid': 'keyword-group-edit-form' } }) }}
                <input type="hidden" name="keyword_group_id" value="{{ keyword_group.id }}">

                <div class="row">
                    <div class="col-md-8">
                        {{ form_row(form.title) }}
                        {{ form_row(form.chapo) }}
                        <div class="mb-3">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description, { attr: { class: 'form-control wysiwyg', rows: 8 } }) }}
                            {{ form_errors(form.description) }}
                        </div>
                        {{ form_row(form.postscriptum) }}
                        {{ form_row(form.code) }}
                        <div class="form-check mb-3">
                            {{ form_widget(form.visible, { attr: { class: 'form-check-input' } }) }}
                            {{ form_label(form.visible, null, { label_attr: { class: 'form-check-label' } }) }}
                        </div>
                    </div>
                    <div class="col-md-4">
                        <p class="text-muted small">
                            {{ 'Keyword group created on %date_create. Last modification: %date_change'|trans({
                                '%date_create': keyword_group.created_at ? keyword_group.created_at|format_datetime('medium', 'short') : '-',
                                '%date_change': keyword_group.updated_at ? keyword_group.updated_at|format_datetime('medium', 'short') : '-',
                            }, 'keyword') }}
                        </p>
                    </div>
                </div>

                {{ form_widget(form.id) }}
                {{ form_widget(form.locale) }}
                {{ form_widget(form.success_url) }}
                {{ form_widget(form.error_url) }}
                {{ form_widget(form.error_message) }}
                {% if form._token is defined %}{{ form_widget(form._token) }}{% endif %}

                <button type="submit" class="btn btn-primary" data-testid="keyword-group-edit-submit">
                    <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                </button>
                <a href="{{ path('admin.module.configure', { module_code: 'Keyword' }) }}" class="btn btn-outline-secondary">{{ 'Cancel'|trans }}</a>
            {{ form_end(form, { render_rest: false }) }}
        </div>
    </div>
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('wysiwyg.js', { location: 'keyword-group-edit-js' }) }}
{% endblock %}
