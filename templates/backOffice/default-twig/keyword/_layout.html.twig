{# Shared shell for the Keyword module back-office screens (keyword & keyword group, view & edit).

   Factors out the base extension, the breadcrumb trail and the page header so each screen
   only declares its own title, breadcrumb tail and body. Child templates override:
     - `kw_title`      page title (already translated)
     - `kw_breadcrumb` extra breadcrumb items (<li> elements) after "Keywords"
     - `kw_actions`    buttons rendered on the right of the page header (e.g. prev/next nav)
     - `kw_body`       page content #}
{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{% block kw_title %}{{ 'Keywords'|trans({}, 'keyword') }}{% endblock %}{% endblock %}
{% block body_testid %}keyword-page{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.module.configure', { module_code: 'Keyword' }) }}">{{ 'Keywords'|trans({}, 'keyword') }}</a></li>
            {% block kw_breadcrumb %}{% endblock %}
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="keyword-page-content">
        <div class="bo-page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <h1 class="h4 mb-0">{{ block('kw_title') }}</h1>
            <div class="d-flex flex-wrap align-items-center gap-2">
                {% block kw_actions %}{% endblock %}
            </div>
        </div>

        {% block kw_body %}{% endblock %}
    </div>
{% endblock %}
